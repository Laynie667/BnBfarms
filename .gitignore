node_modules/
# never commit logins or ledger backups (they hold member numbers and private play data)
.env
*.ledger.json
ledger-backup*.json

# private add-ons (addons/private-*): only on the bot's PC, never on GitHub
addons/private-*/
dist/farmhand-private-*.user.js

# the server runner: its login, its ledger and its browser stay on the server
vps/.env
vps/data/
vps/node_modules/

# the outfit studio's catalogue pages: pictures made on this computer, never on GitHub
studio/catalogue/
tests/out/

# the outfit studio's copy of the live game's files (fetched from its site as they're needed)
studio/game-cache/

# the bot's backup folder, if it's picked inside the project (03b-storage.js): the books, never on GitHub
Backups/
bnb-ledger-*.json
