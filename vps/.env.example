# Copy this file to .env (same folder) and fill in the two lines below. Nobody but you should read .env.
# The bot account's NAME (the login name, not the nickname) and its password:
BOT_USER=
BOT_PASS=

# The game address the farm uses (leave as it is unless the farm moves):
GAME_URL=https://www.bondageprojects.elementfx.com/

# The farm's clock: greetings, curfew, feeding times and breedin' season all go by it.
TZ=America/Chicago

# How often to check GitHub for new scripts, in minutes (0 = never):
UPDATE_MIN=30

# The game's drawing speed, frames a second. Nobody is watching, so low is fine and saves a lot of CPU:
FPS=4

# The bot's own Companion panel (yes/no):
LOAD_COMPANION=yes

# Scripts in dist/ to leave out, comma separated (for example farmhand-shows.user.js):
SKIP_SCRIPTS=

# Other mods to load on the bot's account, comma separated addresses or files (for example a FUSAM loader).
# Leave empty unless you know you need one:
EXTRA_SCRIPTS=
